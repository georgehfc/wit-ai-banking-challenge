{
  "$description": "DTCG 2025.10 format. Two tiers: primitives → semantic (light/dark). Values marked placeholder until George sets the visual direction. Names mirror Figma variables.",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0":   { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
        "50":  { "$value": { "colorSpace": "srgb", "components": [0.957, 0.957, 0.961], "hex": "#F4F4F5" } },
        "200": { "$value": { "colorSpace": "srgb", "components": [0.894, 0.894, 0.906], "hex": "#E4E4E7" } },
        "500": { "$value": { "colorSpace": "srgb", "components": [0.42, 0.42, 0.451], "hex": "#6B6B73" } },
        "800": { "$value": { "colorSpace": "srgb", "components": [0.153, 0.153, 0.165], "hex": "#27272A" } },
        "900": { "$value": { "colorSpace": "srgb", "components": [0.094, 0.094, 0.106], "hex": "#18181B" } }
      },
      "accent": { "$description": "placeholder: George picks", "500": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.2, 0.2], "hex": "#333333" } } },
      "ai":     { "$description": "placeholder: assistant marker only", "500": { "$value": { "colorSpace": "srgb", "components": [0.4, 0.4, 0.4], "hex": "#666666" } } }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": { "value": 4, "unit": "px" } }, "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } }, "4": { "$value": { "value": 16, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } }, "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": { "value": 8, "unit": "px" } }, "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } }, "pill": { "$value": { "value": 999, "unit": "px" } }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "$type": "color",
        "surface": { "default": { "$value": "{primitive.color.neutral.0}" }, "raised": { "$value": "{primitive.color.neutral.50}" } },
        "text": { "default": { "$value": "{primitive.color.neutral.900}" }, "muted": { "$value": "{primitive.color.neutral.500}" } },
        "border": { "default": { "$value": "{primitive.color.neutral.200}" } },
        "accent": { "default": { "$value": "{primitive.color.accent.500}" } },
        "ai": { "marker": { "$value": "{primitive.color.ai.500}" } }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "surface": { "default": { "$value": "{primitive.color.neutral.900}" }, "raised": { "$value": "{primitive.color.neutral.800}" } },
        "text": { "default": { "$value": "{primitive.color.neutral.0}" }, "muted": { "$value": "{primitive.color.neutral.200}" } },
        "border": { "default": { "$value": "{primitive.color.neutral.800}" } },
        "accent": { "default": { "$value": "{primitive.color.accent.500}" } },
        "ai": { "marker": { "$value": "{primitive.color.ai.500}" } }
      }
    }
  }
}
